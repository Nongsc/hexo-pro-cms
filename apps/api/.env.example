# ------------------------------------------------------------------
# Hexo Pro CMS — backend environment
# Copy to .env and fill in real values.
# ------------------------------------------------------------------

# PostgreSQL (Neon / Supabase / Vercel Postgres). REQUIRED.
DATABASE_URL="postgresql://user:password@host:5432/hexo_pro_cms?sslmode=require"

# JWT auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Port for local development
PORT=4300

# Frontend origin (CORS)
WEB_ORIGIN="http://localhost:8848"

# --- Optional defaults (can also be configured in the admin UI) ---
# GitHub connection used to read/write the Hexo source repository.
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_BRANCH="master"

# Tencent Cloud COS
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
COS_CUSTOM_DOMAIN=""
